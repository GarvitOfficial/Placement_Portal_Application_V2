# ── Placement Portal backend environment ─────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# development | production
FLASK_ENV=development

# Database (defaults to SQLite at backend/instance/placement.db)
# DATABASE_URL=postgresql://user:pass@localhost:5432/placement

# Redis (Celery broker + result backend + cache)
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=12

# SMTP (used for reminders, monthly reports, export emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-account@gmail.com

# Admin account seeded on first boot (no admin registration UI exists)
ADMIN_EMAIL=admin@placement.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
